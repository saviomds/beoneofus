# ── dependencies ────────────────────────────────────────────────
node_modules/
apps/*/node_modules/

# ── build output ───────────────────────────────────────────────
apps/*/.next/
apps/*/out/
apps/*/build/
apps/*/dist/
apps/*/dist-server/
apps/web/next-env.d.ts
*.tsbuildinfo

# ── Core runtime data (JSON store — never commit; lives on the encrypted volume) ──
apps/core/data/

# ── env ────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env*.example

# ── editor / OS / tooling ──────────────────────────────────────
.claude/settings.local.json
.claude/settings.json
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
apps/web/.vercel/
.vercel

# ── local migration backups (this restructure) ────────────────
_backup_beoneofus_*
