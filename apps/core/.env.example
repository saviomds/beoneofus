# ── apps/core runtime ────────────────────────────────────────────
# Copy to `.env` on the server (never commit the real file).

NODE_ENV=production
PORT=3001

# Absolute path to the JSON data store. In Docker this is the mounted
# volume; on the host it must be a persistent, encrypted, backed-up disk.
BOU_DATA_DIR=/data

# Set true when served over HTTPS (Caddy terminates TLS in front of the app).
COOKIE_SECURE=true

# ── cross-link to the public platform (apps/web) ─────────────────
# Baked in at `vite build` time — set before building the image.
VITE_WEB_URL=https://beoneofus.work

# ── Caddy / reverse proxy ───────────────────────────────────────
SITE_ADDRESS=education.beoneofus.work

# ── off-box encrypted backups (deploy/backup.sh) ────────────────
# age recipient public key (age-keygen); keep the private key OFF this box.
BACKUP_AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# rclone remote:path for the encrypted archives (see `rclone config`).
BACKUP_RCLONE_DEST=b2:beoneofus-core-backups
BACKUP_RETENTION_DAYS=30
