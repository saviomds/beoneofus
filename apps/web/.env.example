# Copy to .env.local and fill in. Easiest: `vercel env pull .env.local`
# (run inside apps/web after `vercel link`). Never commit real values.

# ── Required ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://beoneofus.work

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Comma-separated inbox(es) alerted on new founder/member applications (optional)
ADMIN_NOTIFY_EMAIL=
# Signs the Supabase "send email" auth hook (/api/otp-email). Set this in production.
SUPABASE_HOOK_SECRET=

# ── Payments (Paystack) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Web push ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@beoneofus.work

# ── Admin / ops ─────────────────────────────────────────────────────────────
ADMIN_SECTION_PASSWORD=
CRON_SECRET=

# ── AI moderation (any one) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional: server-only Supabase URL override (falls back to NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_URL=
