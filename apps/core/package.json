{
  "name": "beoneofus-core",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite\" \"tsx watch --tsconfig tsconfig.server.json server/index.ts\"",
    "dev:api": "tsx watch --tsconfig tsconfig.server.json server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "cross-env NODE_ENV=production tsx --tsconfig tsconfig.server.json server/index.ts",
    "preview": "npm run build && npm run start",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint -c eslint.config.js src shared server",
    "test": "tsx --tsconfig tsconfig.server.json --test server/test/*.test.ts",
    "seed": "tsx --tsconfig tsconfig.server.json server/scripts/generate-seed.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "nanoid": "^5.0.7",
    "pdfkit": "^0.15.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^7.0.0"
  }
}
